---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="The Fuzztones | The Official Website of the Legendary Garage Rock Revival Band"
  description="Official website of The Fuzztones. Tour dates, music, merch, media, and official links."
>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <a href="/" class="hero__logo-link">
        <img
          src="/assets/logos/fuzztones-logo.png"
          alt="The Fuzztones"
          class="hero__logo"
          loading="eager"
          decoding="async"
        />
      </a>

      <div class="hero__media">
        <img
          src="/assets/images/fuzztones-band-hero.png"
          alt="The Fuzztones band"
          class="hero__image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <h1 id="hero-title" class="hero__statement">
        <span>IN</span>
        <span>FUZZ</span>
        <span>WE</span>
        <span>TRUST</span>
      </h1>

      <p class="hero__description">Official website of The Fuzztones.</p>
    </section>

    <section>
      <h2>Latest</h2>
      <p>News, featured releases, and current updates will appear here.</p>
    </section>

    <section>
      <h2>Tour</h2>
      <p>See upcoming live dates and appearances.</p>
      <p><a href="/tour">View tour dates</a></p>
    </section>

    <section>
      <h2>Music</h2>
      <p>Explore albums, singles, and the wider discography.</p>
      <p><a href="/music">Explore music</a></p>
    </section>

    <section>
      <h2>Merch</h2>
      <p>Find official merchandise, records, and other items.</p>
      <p><a href="/merch">Visit merch</a></p>
    </section>

    <section>
      <h2>Media</h2>
      <p>Browse videos, photos, and visual material.</p>
      <p><a href="/media">Open media</a></p>
    </section>

    <section>
      <h2>Links</h2>
      <p>Bandcamp, official stores, streaming platforms, and more.</p>
      <p><a href="/links">See all links</a></p>
    </section>
  </main>
</MainLayout>
