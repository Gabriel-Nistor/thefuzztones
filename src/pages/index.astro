---
import MainLayout from '../layouts/MainLayout.astro';

const musicGroupSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': 'https://thefuzztones.net/#musicgroup',
  name: 'The Fuzztones',
  url: 'https://thefuzztones.net/',
  logo: 'https://thefuzztones.net/assets/logos/fuzztones-logo.png',
  foundingDate: '1980',
  sameAs: [
    'https://www.instagram.com/fuzztonesofficial/',
    'https://en.wikipedia.org/wiki/The_Fuzztones',
    'https://thefuzztones1.bandcamp.com/',
    'https://open.spotify.com/artist/64CktFSdicLd9XQzV6gkMg',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://thefuzztones.net/#website',
  name: 'The Fuzztones',
  url: 'https://thefuzztones.net/',
};
---

<MainLayout
  title="The Fuzztones | The Official Website of the Legendary Garage Rock Revival Band"
  description="Official website of The Fuzztones. Tour dates, music, merch, media, and official links."
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(musicGroupSchema)}
  />

  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <a href="/" class="hero__logo-link">
        <img
          src="/assets/logos/fuzztones-logo.png"
          alt="The Fuzztones"
          class="hero__logo"
          loading="eager"
          decoding="async"
        />
      </a>

      <div class="hero__media">
        <img
          src="/assets/images/fuzztones-band-hero.png"
          alt="The Fuzztones band"
          class="hero__image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <h1 id="hero-title" class="hero__statement">
        <span>GURUS</span>
        <span>OF</span>
        <span>GARAGE</span>
        <span>GRUNGE</span>
      </h1>
    </section>

    <section class="home-cards" aria-label="Featured sections">
      <div class="home-cards__grid">
        <a href="/#latest-news" class="home-card home-card--news">
          <div class="home-card__news-copy">
            <span class="home-card__label">Latest News</span>

            <div class="home-card__content">
              <h2 class="home-card__title">The Fuzztones vs The World</h2>
              <span class="home-card__news-release"
                >On DVD · 10 November 2026</span
              >
              <span class="home-card__action">Discover the documentary →</span>
            </div>
          </div>

          <div class="home-card__news-artwork" aria-hidden="true">
            <img
              src="/assets/images/cards/dvd-fuzztones-vs-the-world.jpg"
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        </a>

        <a href="/tour" class="home-card home-card--tour">
          <span class="home-card__label">Tour</span>

          <div class="home-card__content">
            <h2 class="home-card__title">Live & Loud</h2>

            <span class="home-card__action"> See upcoming shows → </span>
          </div>
        </a>

        <a href="/music" class="home-card home-card--music">
          <span class="home-card__label">Music</span>

          <div class="home-card__content">
            <h2 class="home-card__title">Discography</h2>

            <span class="home-card__action"> Explore the music → </span>
          </div>
        </a>

        <a href="/history" class="home-card home-card--history">
          <span class="home-card__label">History</span>

          <div class="home-card__content">
            <h2 class="home-card__title">The Story Behind the Fuzz</h2>

            <span class="home-card__action"> Read the story → </span>
          </div>
        </a>
      </div>
    </section>

    <!-- Latest news starts here -->
    <section
      id="latest-news"
      class="latest-news"
      aria-labelledby="latest-news-title"
    >
      <h2 id="latest-news-title" class="section-title">Latest News</h2>

      <!-- FEATURED NEWS — THE FUZZTONES VS THE WORLD DVD -->
      <article class="latest-news__feature">
        <div class="latest-news__media">
          <img
            src="/assets/images/cards/news-fuzztones-vs-the-world-dvd.png"
            alt="The Fuzztones vs The World documentary DVD cover"
            class="latest-news__image"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="latest-news__content">
          <div class="latest-news__details">
            <time datetime="2026-11-10">10 November 2026 · DVD Release</time>
          </div>

          <h3 class="latest-news__headline">
            The Fuzztones vs The World — OUT NOW ON DVD!
          </h3>

          <div class="latest-news__copy">
            <p><em>A tale of sex, LSD, and rock n roll.</em></p>

            <p>
              <em>The Fuzztones vs The World</em> chronicles the highs and lows of
              a band whose career has spanned more than four decades of garage rock.
            </p>

            <p>
              From their beginnings in New York City in 1980 to their enduring
              influence on psychedelic punk and garage rock, discover the story
              behind The Fuzztones.
            </p>

            <p>
              <strong>OUT NOW ON DVD!</strong>
            </p>

            <p>
              Order your copy today from your favourite local record or DVD
              shop, or from online retailers including Amazon and MVD Shop.
            </p>

            <p>
              <strong>Support independent retailers whenever possible!</strong>
            </p>
          </div>

          <div class="latest-news__actions">
            <a
              href="/news#fuzztones-vs-the-world"
              class="latest-news__button latest-news__button--primary"
            >
              Read More →
            </a>

            <a href="/media#fuzztones-vs-the-world" class="latest-news__button">
              Official Trailer →
            </a>
          </div>
        </div>
      </article>

      <!-- SECONDARY NEWS — SPANISH TOUR -->
      <article class="latest-news__secondary">
        <div class="latest-news__secondary-media">
          <img
            src="/assets/images/cards/2026-tour-spain-november.jpeg"
            alt="The Fuzztones Spanish tour poster listing six concerts from 23 to 28 November 2026"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="latest-news__secondary-content">
          <div class="latest-news__details">
            <time datetime="2026-11-23">23–28 November 2026</time>
          </div>

          <p class="latest-news__secondary-tagline">
            <em>Six nights of fuzz across Spain!</em>
          </p>

          <h3 class="latest-news__secondary-headline">
            The Fuzztones — Spanish Tour 2026
          </h3>

          <p class="latest-news__secondary-copy">
            The Fuzztones return to Spain this November for six live shows:
            Burgos, Santiago de Compostela, Oviedo, Santander, Bilbao and Madrid
            (SOLD OUT).
          </p>

          <a href="/tour" class="latest-news__button">
            View Tour Dates and Ticket Links →
          </a>
        </div>
      </article>

      <!-- SECONDARY NEWS — JUST ONCE LP -->
      <article class="latest-news__secondary">
        <div class="latest-news__secondary-media">
          <img
            src="/assets/images/cards/fuzztones-vinyl-just-once.png"
            alt="The Fuzztones Just Once purple marble vinyl LP"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="latest-news__secondary-content">
          <div class="latest-news__details">
            <time datetime="2026-11-06">6 November 2026 · LP Release</time>
          </div>

          <p class="latest-news__secondary-tagline">
            <em>New Fuzztones LP — now available!</em>
          </p>

          <h3 class="latest-news__secondary-headline">
            The Fuzztones — Just Once
          </h3>

          <p class="latest-news__secondary-copy">
            <em>Just Once</em> digs into the band's live archives for rare performances
            of songs they apparently played live only once. A collection of unusual
            moments and deep-cut Fuzztones history.
          </p>

          <p class="latest-news__secondary-copy">
            <strong>Out now on Cleopatra Records.</strong>
          </p>

          <a href="/news#just-once" class="latest-news__button">
            Read More →
          </a>
        </div>
      </article>
    </section>

    <!-- ------------- Latest news ends here ------------- -->
  </main>
</MainLayout>
