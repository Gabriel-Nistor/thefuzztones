---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="The Fuzztones | The Official Website of the Legendary Garage Rock Revival Band"
  description="Official website of The Fuzztones. Tour dates, music, merch, media, and official links."
>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <a href="/" class="hero__logo-link">
        <img
          src="/assets/logos/fuzztones-logo.png"
          alt="The Fuzztones"
          class="hero__logo"
          loading="eager"
          decoding="async"
        />
      </a>

      <div class="hero__media">
        <img
          src="/assets/images/fuzztones-band-hero.png"
          alt="The Fuzztones band"
          class="hero__image"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <h1 id="hero-title" class="hero__statement">
        <span>IN</span>
        <span>FUZZ</span>
        <span>WE</span>
        <span>TRUST</span>
      </h1>

      <p class="hero__description">Official website of The Fuzztones.</p>
    </section>

    <section class="home-cards" aria-label="Featured sections">
      <div class="home-cards__grid">
        <a href="/#latest-news" class="home-card home-card--news">
          <span class="home-card__label">Latest News</span>

          <div class="home-card__content">
            <h2 class="home-card__title">Halloween Show in Berlin</h2>

            <span class="home-card__action"> Read latest news → </span>
          </div>
        </a>

        <a href="/#tour" class="home-card home-card--tour">
          <span class="home-card__label">Tour</span>

          <div class="home-card__content">
            <h2 class="home-card__title">Live & Loud</h2>

            <span class="home-card__action"> See upcoming shows → </span>
          </div>
        </a>

        <a href="/music" class="home-card home-card--music">
          <span class="home-card__label">Music</span>

          <div class="home-card__content">
            <h2 class="home-card__title">Discography</h2>

            <span class="home-card__action"> Explore the music → </span>
          </div>
        </a>

        <a href="/about" class="home-card home-card--history">
          <span class="home-card__label">History</span>

          <div class="home-card__content">
            <h2 class="home-card__title">The Story Behind the Fuzz</h2>

            <span class="home-card__action"> Read the story → </span>
          </div>
        </a>
      </div>
    </section>
    <!-- Latest news starts here -->
    <section
      id="latest-news"
      class="latest-news"
      aria-labelledby="latest-news-title"
    >
      <h2 id="latest-news-title" class="section-title">Latest News</h2>

      <article class="latest-news__feature">
        <div class="latest-news__media">
          <img
            src="/assets/images/cards/news-halloween-berlin.jpg"
            alt="The Fuzztones Halloween show in Berlin"
            class="latest-news__image"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="latest-news__content">
          <div class="latest-news__details">
            <time datetime="2026-10-31T21:00"> 31 October 2026 · 9 PM </time>

            <a
              href="https://maps.app.goo.gl/ngtTfRFDAkJsJw9d6"
              target="_blank"
              rel="noreferrer"
            >
              BI NUU · U-Bhf Schlesisches Tor · Berlin
            </a>
          </div>

          <h3 class="latest-news__headline">
            The Fuzztones Halloween Show Returns to Berlin
          </h3>

          <div class="latest-news__copy">
            <p>
              After ten years, The Fuzztones’ legendary Halloween show returns
              to Berlin!
            </p>

            <p>
              Expect a night packed with the dark, spooky and twisted sounds of
              <em> Monster A Go-Go</em>, plenty of surprises, a secret themed
              band costume and a stage transformed especially for Halloween.
            </p>

            <p>
              <strong>
                One night. One special Halloween set. And plenty we’re not going
                to reveal just yet.
              </strong>
            </p>

            <p>
              <strong>Come out, come out, whatever you are!</strong>
            </p>
          </div>

          <div class="latest-news__actions">
            <a
              href="https://hoochiekoo.us5.list-manage.com/subscribe?u=9b3912f7178474c83082a0ee9&id=b717cc285a"
              class="latest-news__button latest-news__button--primary"
              target="_blank"
              rel="noreferrer"
            >
              Get Tickets →
            </a>

            <a
              href="https://maps.app.goo.gl/ngtTfRFDAkJsJw9d6"
              class="latest-news__button"
              target="_blank"
              rel="noreferrer"
            >
              View Location →
            </a>
          </div>
        </div>
      </article>
    </section>

    <!-- ------------- Latest news ends here ------------- -->

    <section
      id="tour"
      class="home-placeholder home-placeholder--tour"
      aria-labelledby="tour-title"
    >
      <h2 id="tour-title" class="section-title">On Tour</h2>

      <div class="home-placeholder__box">Tour dates will go here</div>

      <a href="/tour" class="home-placeholder__link"> View full Tour page → </a>
    </section>

    <style>
      .home-explore,
      .home-placeholder {
        width: min(calc(100% - 3rem), var(--container-width));
        margin-inline: auto;
        padding-block: 5rem;
      }

      .home-explore__grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.5rem;
      }

      .home-explore__card {
        min-height: 260px;

        display: flex;
        align-items: flex-end;

        padding: 2rem;

        color: white;
        font-size: clamp(2rem, 4vw, 4rem);
        text-decoration: none;
        text-transform: uppercase;
      }

      .home-explore__card--news {
        background: #7a1e1e;
      }

      .home-explore__card--tour {
        background: #244f69;
      }

      .home-explore__card--music {
        background: #4b3d73;
      }

      .home-explore__card--merch {
        background: #536b35;
      }

      .home-placeholder__box {
        min-height: 480px;

        display: grid;
        place-items: center;

        margin-top: 2rem;
        padding: 2rem;

        font-size: 1.5rem;
        text-align: center;
      }

      .home-placeholder--news .home-placeholder__box {
        background: #704d21;
      }

      .home-placeholder--tour .home-placeholder__box {
        background: #315b50;
      }

      .home-placeholder__link {
        display: inline-block;
        margin-top: 1.5rem;
      }

      #latest-news,
      #tour {
        scroll-margin-top: 2rem;
      }

      @media (max-width: 800px) {
        .home-explore,
        .home-placeholder {
          width: min(calc(100% - 2rem), var(--container-width));
          padding-block: 3rem;
        }

        .home-explore__grid {
          grid-template-columns: 1fr;
          gap: 1rem;
        }

        .home-explore__card {
          min-height: 180px;
          padding: 1.5rem;

          font-size: clamp(2rem, 11vw, 3.5rem);
        }

        .home-placeholder__box {
          min-height: 320px;
        }
      }
    </style>
  </main>
</MainLayout>
