---
import MainLayout from '../layouts/MainLayout.astro';
import tourData from '../data/tour.json';
import { isPastDate } from '../utils/tour-dates.js';

type TourEvent = {
  date: string;
  endDate?: string;
  timeZone?: string;
  kind?: string;
  type: string;
  city: string;
  venue?: string;
  location?: string;
  note?: string;
  time?: string;
  timeLabel?: string;
  ticketUrl?: string;
  ticketLabel?: string;
  dateDisplay?: { day: string; month: string; year: string };
};

const events: TourEvent[] = tourData;
const now = new Date();
const isPast = (event: TourEvent) =>
  isPastDate(event.endDate ?? event.date, event.timeZone, now);

// A tour announcement is not an individual concert. Hide it after the tour.
const upcoming = events
  .filter((event) => !isPast(event))
  .sort((a, b) => a.date.localeCompare(b.date));
const past = events
  .filter((event) => isPast(event) && event.kind !== 'announcement')
  .sort((a, b) => b.date.localeCompare(a.date));

function dateParts(event: TourEvent) {
  if (event.dateDisplay) return event.dateDisplay;
  const [year, month, day] = event.date.split('-');
  return {
    day: String(Number(day)),
    month: new Intl.DateTimeFormat('en-GB', {
      month: 'long',
      timeZone: 'UTC',
    }).format(new Date(Date.UTC(Number(year), Number(month) - 1, 1))),
    year,
  };
}
---

<MainLayout
  title="Tour | The Fuzztones"
  description="The Fuzztones tour dates and live shows. See upcoming concerts, venues, dates and ticket information."
>
  <main>
    <header class="page-header page-header--tour">
      <span class="page-header__eyebrow">The Fuzztones</span>

      <h1 class="page-title">Tour</h1>

      <div class="page-header__rule" aria-hidden="true"></div>
    </header>

    <div class="tour-bandsintown">
      <a
        href="https://www.bandsintown.com/a/130036-the-fuzztones"
        target="_blank"
        rel="noreferrer"
        class="tour-bandsintown__link"
      >
        Follow The Fuzztones on Bandsintown →
      </a>
    </div>

    <section
      class="tour-page"
      data-tour-page
      aria-labelledby="upcoming-shows-title"
    >
      <h2 id="upcoming-shows-title" class="section-title">
        Upcoming Shows
      </h2>
      <p data-tour-empty hidden={upcoming.length > 0}>
        More tour dates will be announced soon.
      </p>

      {[
        { isArchive: false, entries: upcoming },
        { isArchive: true, entries: past },
      ].map(({ isArchive, entries }) => (
        <>
          {isArchive && (
            <>
              <h2 id="past-events-title" class="section-title">
                Past Events
              </h2>
              <div class="tour-history">
                <p class="tour-history__intro">
                  Since the 1980s, The Fuzztones have toured extensively across
                  the United States, the UK and Europe, with later adventures
                  taking them to Japan, Brazil, Costa Rica, Uruguay and
                  Argentina.
                </p>

                <p class="tour-history__note">
                  An archive of documented past performances is being assembled.
                  More shall be revealed soon...
                </p>
              </div>
            </>
          )}

          {entries.map((event) => {
            const date = dateParts(event);
            const ticketLabel =
              event.ticketLabel ??
              (event.ticketUrl ? 'Get Tickets →' : 'Tickets Available Soon');
            return (
              <article
                class:list={['tour-event', { 'tour-event--past': isArchive }]}
                data-tour-event
                data-tour-date={event.date}
                data-tour-end={event.endDate ?? event.date}
                data-tour-time-zone={event.timeZone ?? 'Europe/London'}
                data-tour-kind={event.kind ?? 'show'}
              >
                <div class="tour-event__date">
                  <span class="tour-event__day">{date.day}</span>
                  <div class="tour-event__date-info">
                    <span class="tour-event__month">{date.month}</span>
                    <span class="tour-event__year">{date.year}</span>
                  </div>
                </div>

                <div class="tour-event__content">
                  <span class="tour-event__type">{event.type}</span>
                  <h3 class="tour-event__city">{event.city}</h3>
                  {event.venue && (
                    <p class="tour-event__venue">{event.venue}</p>
                  )}
                  {event.location && (
                    <p class="tour-event__location">{event.location}</p>
                  )}
                  {event.note && (
                    <p class="tour-event__location">{event.note}</p>
                  )}
                  {event.time && (
                    <time
                      class="tour-event__time"
                      datetime={`${event.date}T${event.time}`}
                    >
                      {event.timeLabel ?? event.time}
                    </time>
                  )}
                </div>

                <div
                  class="tour-event__actions"
                  data-tour-actions
                  hidden={isArchive}
                >
                  {event.ticketUrl ? (
                    <a
                      href={event.ticketUrl}
                      class="tour-event__button tour-event__button--primary"
                      target="_blank"
                      rel="noreferrer"
                    >
                      {ticketLabel}
                    </a>
                  ) : (
                    <span class="tour-event__button tour-event__button--primary">
                      {ticketLabel}
                    </span>
                  )}
                </div>
              </article>
            );
          })}
        </>
      ))}
    </section>
  </main>
</MainLayout>

<style>
  [data-tour-actions][hidden],
  [data-tour-empty][hidden] {
    display: none !important;
  }

  [data-tour-empty]:not([hidden]) + #past-events-title {
    margin-top: 4rem;
  }
</style>

<script>
  import { isPastDate } from '../utils/tour-dates.js';

  // GitHub Pages serves static HTML. Refresh the categories in the browser
  // so concerts move to the archive without another build or deployment.
  function updateTourCategories() {
    const page = document.querySelector('[data-tour-page]');
    if (!page) return;
    const pastTitle = page.querySelector('#past-events-title');
    const empty = page.querySelector<HTMLElement>('[data-tour-empty]');
    if (!pastTitle || !empty) return;

    const now = new Date();
    const upcoming: HTMLElement[] = [];
    const past: HTMLElement[] = [];

    for (const article of page.querySelectorAll<HTMLElement>(
      '[data-tour-event]',
    )) {
      const { tourDate, tourEnd, tourTimeZone, tourKind } = article.dataset;
      if (!tourDate || !tourEnd) continue;
      const archived = isPastDate(tourEnd, tourTimeZone, now);

      if (archived && tourKind === 'announcement') {
        article.remove();
        continue;
      }

      article.classList.toggle('tour-event--past', archived);
      const actions = article.querySelector<HTMLElement>('[data-tour-actions]');
      if (actions) actions.hidden = archived;
      (archived ? past : upcoming).push(article);
    }

    const dateOrder = (a: HTMLElement, b: HTMLElement) =>
      (a.dataset.tourDate ?? '').localeCompare(b.dataset.tourDate ?? '');

    upcoming
      .sort(dateOrder)
      .forEach((article) => page.insertBefore(article, pastTitle));
    past
      .sort((a, b) => dateOrder(b, a))
      .forEach((article) => page.append(article));
    empty.hidden = upcoming.length > 0;
  }

  updateTourCategories();
  document.addEventListener('astro:page-load', updateTourCategories);
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) updateTourCategories();
  });
</script>
