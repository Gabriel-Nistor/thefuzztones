---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Tour | The Fuzztones"
  description="The Fuzztones tour dates and live shows. See upcoming concerts, venues, dates and ticket information."
>
  <main>
    <header class="page-header page-header--tour">
      <span class="page-header__eyebrow">The Fuzztones</span>

      <h1 class="page-title">Tour</h1>

      <div class="page-header__rule" aria-hidden="true"></div>
    </header>

    <div class="tour-bandsintown">
      <a
        href="https://www.bandsintown.com/a/130036-the-fuzztones"
        target="_blank"
        rel="noreferrer"
        class="tour-bandsintown__link"
      >
        Follow The Fuzztones on Bandsintown →
      </a>
    </div>

    <section class="tour-page" aria-labelledby="upcoming-shows-title">
      <h2 id="upcoming-shows-title" class="section-title">Upcoming Shows</h2>

      <article class="tour-event">
        <div class="tour-event__date">
          <span class="tour-event__day">31</span>

          <div class="tour-event__date-info">
            <span class="tour-event__month">October</span>
            <span class="tour-event__year">2026</span>
          </div>
        </div>

        <div class="tour-event__content">
          <span class="tour-event__type"> Halloween Show </span>

          <h3 class="tour-event__city">Berlin, Germany</h3>

          <p class="tour-event__venue">BI NUU</p>

          <p class="tour-event__location">U-Bhf Schlesisches Tor · Berlin</p>

          <time class="tour-event__time" datetime="2026-10-31T21:00">
            21:00
          </time>
        </div>

        <div class="tour-event__actions">
          <a
            href="https://hoochiekoo.us5.list-manage.com/subscribe?u=9b3912f7178474c83082a0ee9&id=b717cc285a"
            class="tour-event__button tour-event__button--primary"
            target="_blank"
            rel="noreferrer"
          >
            Get Tickets →
          </a>
        </div>
      </article>

      <article class="tour-event">
        <div class="tour-event__date">
          <s>
            <div class="tour-event__date-info">
              <span class="tour-event__month">7 November</span>
              <span class="tour-event__year">2026</span>
            </div>
          </s>
        </div>

        <div class="tour-event__content">
          <s><h3 class="tour-event__city">London, UK</h3></s>

          <s><p class="tour-event__venue">The Dome</p></s>

          <s><p class="tour-event__location">Tufnell Park · London</p></s>
        </div>

        <div class="tour-event__actions">SHOW CANCELLED</div>
      </article>

      <article class="tour-event">
        <div class="tour-event__date">
          <span class="tour-event__day">24</span>

          <div class="tour-event__date-info">
            <span class="tour-event__month">November</span>
            <span class="tour-event__year">2026</span>
          </div>
        </div>

        <div class="tour-event__content">
          <span class="tour-event__type"> Live Show </span>

          <h3 class="tour-event__city">Santiago de Compostela, Spain</h3>

          <p class="tour-event__venue">Sala Capitol</p>

          <p class="tour-event__location">
            Rúa de Concepción Arenal, 5, 15702 Santiago de Compostela, A Coruña
          </p>

          <time class="tour-event__time" datetime="2026-11-24T20:00">
            20:00
          </time>
        </div>

        <div class="tour-event__actions">
          <a
            href="https://outonocodaxfest.entradas.plus/entradas/es/outonocodax-24nov-capitol"
            class="tour-event__button tour-event__button--primary"
            target="_blank"
            rel="noreferrer"
          >
            Get Tickets →
          </a>
        </div>
      </article>

      <article class="tour-event">
        <div class="tour-event__date">
          <span class="tour-event__day">26</span>

          <div class="tour-event__date-info">
            <span class="tour-event__month">November</span>
            <span class="tour-event__year">2026</span>
          </div>
        </div>

        <div class="tour-event__content">
          <span class="tour-event__type"> Live Show </span>

          <h3 class="tour-event__city">Santander, Spain</h3>

          <p class="tour-event__venue">Rock Beer The New</p>

          <p class="tour-event__location">
            C. Peñas Redondas, 15 39010, Santander, Cantabria
          </p>

          <time class="tour-event__time" datetime="2026-11-26T22:00">
            22:00
          </time>
        </div>

        <div class="tour-event__actions">
          <a
            href="https://entradium.com/events/the-fuzztones-santander-rock-beer-the-new"
            class="tour-event__button tour-event__button--primary"
            target="_blank"
            rel="noreferrer"
          >
            Get Tickets →
          </a>
        </div>
      </article>

      <article class="tour-event">
        <div class="tour-event__date">
          <span class="tour-event__day">27</span>

          <div class="tour-event__date-info">
            <span class="tour-event__month">November</span>
            <span class="tour-event__year">2026</span>
          </div>
        </div>

        <div class="tour-event__content">
          <span class="tour-event__type"> Live Show </span>

          <h3 class="tour-event__city">Bilbao, Spain</h3>

          <p class="tour-event__venue">D8 Sorkuntza Faktoria</p>

          <p class="tour-event__location">
            D8 Sorkuntza Faktoria, Calle Astillero 18
          </p>

          <time class="tour-event__time" datetime="2026-11-26T20:00">
            20:00
          </time>
        </div>

        <div class="tour-event__actions">
          <a
            href="https://entradium.com/events/the-fuzztones-los-paniks-bilbao-d8-sorkuntza-faktoria"
            class="tour-event__button tour-event__button--primary"
            target="_blank"
            rel="noreferrer"
          >
            Get Tickets →
          </a>
        </div>
      </article>

      <article class="tour-event">
        <div class="tour-event__date">
          <span class="tour-event__day">28</span>

          <div class="tour-event__date-info">
            <span class="tour-event__month">November</span>
            <span class="tour-event__year">2026</span>
          </div>
        </div>

        <div class="tour-event__content">
          <span class="tour-event__type"> Live Show </span>

          <h3 class="tour-event__city">Madrid, Spain</h3>

          <p class="tour-event__venue">GRUTA 77</p>

          <p class="tour-event__location">C. Cuclillo, 6 · 28019 Madrid</p>

          <time class="tour-event__time" datetime="2026-11-28T21:30">
            21:30
          </time>
        </div>

        <div class="tour-event__actions">
          <a
            href="https://gruta77.movingtickets.com/Entradas-Fuzztones-concierto-en-Gruta77-Madrid"
            class="tour-event__button tour-event__button--primary"
            target="_blank"
            rel="noreferrer"
          >
            Get Tickets →
          </a>
        </div>
      </article>

      <article class="tour-event">
        <div class="tour-event__date">
          <span class="tour-event__day">16</span>

          <div class="tour-event__date-info">
            <span class="tour-event__month">January</span>
            <span class="tour-event__year">2027</span>
          </div>
        </div>

        <div class="tour-event__content">
          <span class="tour-event__type"> Live Show </span>

          <h3 class="tour-event__city">Milan, Italy</h3>

          <p class="tour-event__venue">Slaughter Club</p>

          <p class="tour-event__location">Milan · Italy</p>
        </div>

        <div class="tour-event__actions">
          <span class="tour-event__button tour-event__button--primary">
            Tickets Available Soon
          </span>
        </div>
      </article>

      <article class="tour-event">
        <div class="tour-event__date">
          <span class="tour-event__day">Spain</span>

          <div class="tour-event__date-info">
            <span class="tour-event__month">Tour</span>
            <span class="tour-event__year">2027</span>
          </div>
        </div>

        <div class="tour-event__content">
          <span class="tour-event__type"> Upcoming Tour Dates </span>

          <h3 class="tour-event__city">The Fuzztones in Spain 2027</h3>

          <p class="tour-event__location">April 16–24, 2027</p>

          <p class="tour-event__location">
            Full dates and venues will be announced soon.
          </p>
        </div>

        <div class="tour-event__actions">
          <span class="tour-event__button tour-event__button--primary">
            More Details Soon
          </span>
        </div>
      </article>

      <h2 id="past-events-title" class="section-title">Past Events</h2>
    </section>
  </main>
</MainLayout>
