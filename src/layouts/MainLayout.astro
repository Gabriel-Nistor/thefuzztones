---
import '../styles/global.css';

import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Official website of The Fuzztones. Tour dates, music, merch, media, and official links.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="site-loading">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      rel="preload"
      href="/assets/fonts/GreenFuzz.otf"
      as="font"
      type="font/otf"
      crossorigin
    />

    <style is:inline>
      html {
        background: #050505;
      }

      html.site-loading body {
        opacity: 0;
      }

      body {
        transition: opacity 240ms ease;
      }

      @media (prefers-reduced-motion: reduce) {
        body {
          transition: none;
        }
      }
    </style>

    <noscript>
      <style>
        html.site-loading body {
          opacity: 1;
        }
      </style>
    </noscript>

    <Head title={title} description={description} />
  </head>

  <body>
    <Header />
    <slot />
    <Footer />

    <script is:inline>
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          document.documentElement.classList.remove('site-loading');
        });
      });
    </script>
  </body>
</html>
